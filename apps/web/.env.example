# Public HTTPS origin of the API on the VPS (no trailing slash, no /v1).
# Next forwards /api/* here, so the browser stays same-origin and cookies keep working.
# Required on Vercel (the build fails without it). Baked into the rewrites at build time.
NEXT_PUBLIC_API_URL=http://localhost:7781

# Self-hosted (PM2) only: loopback address of the API; wins over NEXT_PUBLIC_API_URL when set
# INTERNAL_API_URL=http://127.0.0.1:7791

# Canonical URL of the site: metadata, sitemap, robots
NEXT_PUBLIC_SITE_URL=http://localhost:7782

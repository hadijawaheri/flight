NODE_ENV=development
PORT=7781
HOST=127.0.0.1
DATABASE_URL=mongodb://127.0.0.1:27018/flysmart?replicaSet=rs0

# generate: openssl rand -base64 48
JWT_ACCESS_SECRET=
OTP_HMAC_SECRET=

# Encrypts national codes and passport numbers in the database (ADR 0012); required in production.
# generate: openssl rand -base64 32. Losing it makes stored identities unreadable: back it up.
PII_ENCRYPTION_KEY=

CORS_ORIGINS=http://localhost:7782

# console prints the OTP in dev; forbidden in production
SMS_PROVIDER=console
# melipayamak: console API key, the approved OTP pattern id (one variable: the code),
# and optionally a dedicated line for price-alert texts
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_OTP_BODY_ID=
MELIPAYAMAK_FROM=
OTP_FIXED_CODE=
THROTTLE_ENABLED=true

# Seat holds and payments use Mongo transactions, so DATABASE_URL must point at a replica set
# Dev only: lets the OTP step accept this fixed code; forbidden in production
ALLOW_DEV_AUTH=false

# Simulated market and gateway until real providers exist
FLIGHT_PROVIDER=simulation
PAYMENT_PROVIDER=mock
# Production demo with real SMS sign-in but the simulated gateway
ALLOW_SIMULATED_PAYMENTS=false

# Assistant: leave the key empty to run on the built-in knowledge base only (offline mode)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
ASSISTANT_TIMEOUT_MS=30000

# Background sweepers (price alerts every 15 min, unpaid bookings every minute)
ALERTS_WATCHER_ENABLED=true
BOOKING_EXPIRER_ENABLED=true

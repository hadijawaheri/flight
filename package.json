{
  "name": "flysmart",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:all": "node scripts/start-dev.mjs",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @flysmart/contracts build && pnpm -r --filter \"!@flysmart/contracts\" build",
    "typecheck": "pnpm --filter @flysmart/contracts build && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @flysmart/contracts build && pnpm -r test",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "~9.39.0",
    "@types/ssh2": "^1.15.6",
    "eslint": "catalog:",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "ssh2": "^1.17.0",
    "typescript-eslint": "^8.71.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
